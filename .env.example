CHROMA_PORT=8000
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_AUTOLOGGING_DISABLE=true
MLFLOW_LANGCHAIN_AUTOLOGGING=false
MLFLOW_DEFAULT_EXPERIMENT=rag_benchmark